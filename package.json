{
    "name": "@gabrielpotter/capp",
    "version": "1.0.2",
    "description": "Calendar rules engine: define calendars as JSON + JS snippets, validate them with hashes, and serve them over a REST API or use them as a library.",
    "main": "dist/lib.js",
    "types": "dist/lib.d.ts",
    "bin": {
        "capp-server": "dist/cli-server.js",
        "capp-tester": "dist/tester.js"
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "build": "tsc && npm run copy:config && npm run copy:calendar",
        "build:bin": "npm run build && pkg dist/tester.js --targets node18-linux,node18-macos,node18-win --output bin/tester",
        "copy:config": "cp src/config.json dist/config.json && cp src/hash.json dist/hash.json",
        "copy:calendar": "rm -rf dist/calendars && cp -r src/calendars dist/calendars",
        "prepublishOnly": "npm run build",
        "start": "node dist/cli-server.js -c dist/calendars --config dist/config.json -h dist",
        "test": "npm run build && node dist/tester.js -c src/calendars -t src/tests -h src"
    },
    "keywords": [
        "calendar",
        "holiday",
        "business-days",
        "workday",
        "rules-engine",
        "date",
        "scheduler",
        "rest-api"
    ],
    "author": "Gabriel Potter",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/GabrielPotter/capp.git"
    },
    "bugs": {
        "url": "https://github.com/GabrielPotter/capp/issues"
    },
    "homepage": "https://github.com/GabrielPotter/capp#readme",
    "dependencies": {
        "commander": "^13.1.0",
        "cors": "^2.8.5",
        "date-fns": "^4.1.0",
        "express": "^4.21.2"
    },
    "devDependencies": {
        "@types/body-parser": "^1.19.5",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "pkg": "^5.8.1",
        "typescript": "^5.8.2"
    }
}
